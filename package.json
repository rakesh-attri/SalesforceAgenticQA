{
  "name": "salesforce-agentic-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "platform": "tsx src/platform-cli.ts",
    "model:check": "tsx src/ai/check.ts",
    "demo": "tsx src/cli.ts demo",
    "demo:graph": "tsx src/cli.ts graph-demo",
    "mcp:salesforce": "tsx src/integrations/mcp-cli.ts",
    "discover:fixture": "tsx src/cli.ts discover --fixture fixtures/org-sample.json",
    "discover:live": "tsx src/cli.ts discover --live",
    "plan": "tsx src/cli.ts plan stories/invoice-payment.json",
    "data:plan": "tsx src/cli.ts data-plan stories/invoice-payment.json",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "unit": "tsx --test --test-concurrency=4 unit/*.test.ts",
    "agents": "playwright init-agents --loop=codex",
    "mcp:browser": "npx @playwright/mcp --headless"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@playwright/mcp": "^0.0.60",
    "@playwright/test": "^1.55.0",
    "chromadb": "^3.0.0",
    "dotenv": "^17.0.0",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "reporting-labs": "0.6.24",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
