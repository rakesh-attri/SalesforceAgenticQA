# Use an authorized sandbox, or the separately approved dedicated personal QA mode.
# Normal Production modes remain read-only/review-only; configuration never authorizes writes.
SF_INSTANCE_URL=https://your-domain--sandbox.sandbox.my.salesforce.com
SF_LOGIN_URL=https://test.salesforce.com
SF_CLIENT_ID=
SF_USERNAME=
SF_PRIVATE_KEY_PATH=.secrets/jwt-server.key
SF_API_VERSION=v62.0
SFQA_OBJECTS=Account,Contact
SFQA_ORG_ALIAS=my-authorized-sandbox
SFQA_KNOWLEDGE_PERMISSION=authorized-api-reader
# Browser identity and origin are separate from API JWT. Leave unset until independently reviewed.
# UI Bridge needs effective web scope (api remains required for API work) and a UI-eligible,
# non-API-Only user. An administrator changes app authorization; the framework never does.
# Approved private state import is an alternative. See docs/BROWSER_AUTHENTICATION.md.
SFQA_BROWSER_ORIGIN=
SFQA_BROWSER_PERSONA=
SFQA_SESSION_RECEIPT=
# Generic Salesforce POST is disabled. Dedicated writes also require scoped approval and fresh sandbox checks.
# Chat and embeddings are configured separately. Empty/none keeps offline deterministic mode.
# Gemini Developer API only (Vertex AI is not configured by these settings).
# Set SFQA_MODEL_PROVIDER=gemini and choose a structured-output-capable model available to your key.
SFQA_MODEL_PROVIDER=none
SFQA_MODEL_NAME=
SFQA_MODEL_API_KEY=
# Optional shared key alias: GEMINI_API_KEY (or GOOGLE_API_KEY).
# Do not set conflicting alias keys/model names. GEMINI_MODEL aliases SFQA_MODEL_NAME.
GEMINI_API_KEY=
SFQA_GEMINI_TIMEOUT_MS=30000
SFQA_GEMINI_RETRIES=2
SFQA_GEMINI_MIN_INTERVAL_MS=0
CHROMA_HOST=
CHROMA_PORT=
CHROMA_TOKEN=
# gemini uses a separate embedding model (not the chat model).
# openai-compatible preserves the existing SFQA_EMBEDDING_URL adapter.
SFQA_EMBEDDING_PROVIDER=none
SFQA_EMBEDDING_URL=
SFQA_EMBEDDING_KEY=
SFQA_EMBEDDING_MODEL=
# Optional output dimensions; the configured embedding model must support the value.
SFQA_EMBEDDING_DIMENSIONS=
# GEMINI_EMBEDDING_MODEL aliases SFQA_EMBEDDING_MODEL for Gemini.
# Dedicated reviewed sandbox tools remain disabled until explicitly configured.
SFQA_WRITE_OBJECTS=
SFQA_ENABLE_APPROVED_TOOLS=false
# Production reads require a named, hash-bound exact org/user/persona/origin policy.
# Prepare with: npm.cmd run platform -- environment-review
# SANDBOX_QA | PRODUCTION_READ_ONLY_QA | PRODUCTION_CONTROLLED_QA (review only).
# DEDICATED_QA_ORG requires a separate named exact-org/user policy, reviewed data/UI
# and private session approvals; no environment flag enables it. See docs/DEDICATED_QA.md.
# Dedicated commands use .state/dedicated-qa-policy.json; keep routine reads on this policy:
SFQA_ENVIRONMENT_POLICY=.state/environment-policy.json
# Optional exact browser origin when preparing dedicated-review; still requires local approval.
# SFQA_BROWSER_ORIGIN=https://your-domain.lightning.force.com
# Legacy ai-reason / rag-index / rag-query require exact redacted payload approval.
SFQA_AI_PAYLOAD_REVIEW=.state/ai-payload-approval.json
# Metadata-to-Gemini: knowledge-review -> inspect/approve bundle -> knowledge-publish -> grounded-plan.
# Provider configuration alone never approves metadata transmission. See docs/ENVIRONMENT_QA.md.
# Small synchronous embedding batches. Queue counters persist across CLI restarts.
SFQA_EMBEDDING_BATCH_SIZE=5
SFQA_INGEST_REQUESTS_PER_RUN=5
SFQA_INGEST_REQUESTS_PER_DAY=30
SFQA_INGEST_TEXTS_PER_DAY=100
SFQA_INGEST_MIN_INTERVAL_MS=1000
# These are local ingestion guardrails, not your provider project's actual quota.
